theory RangerIoT_LKH_MultiEpoch_4Member

begin

builtins: symmetric-encryption


/********************************************************************
 * STEP 7D.2-B
 *
 * Exact reference instance derived from implemented LkhKeyTree:
 *
 * members 1,2,3,4
 *
 * tree:
 *
 *           n1
 *         /    \
 *       n2      n3
 *      /  \    /  \
 *    n4   n5 n6   n7
 *    m1   m2 m3   m4
 *
 * epoch e1:
 *   revoke m4
 *
 *   update n3/v1 under n6/v0 -> m3
 *   update n1/v1 under n2/v0 -> m1,m2
 *   update n1/v1 under n3/v1 -> m3
 *
 * epoch e2:
 *   revoke m3
 *
 *   update n1/v2 under n2/v0 -> m1,m2
 *
 * This is NOT a generic arbitrary-N LKH theorem.
 ********************************************************************/


/********************************************************************
 * SETUP
 ********************************************************************/

rule Setup:
  [
      Fr(~k4),
      Fr(~k5),
      Fr(~k6),
      Fr(~k7),
      Fr(~k2v0),
      Fr(~k3v0),
      Fr(~root0)
  ]
  --[
      Setup('gm'),

      EpochRoot(
          'e0',
          'v0',
          ~root0
      )
    ]->
  [
      !GroupContext(
          'gm',
          'm1',
          'm2',
          'm3',
          'm4'
      ),

      !Parent('n4','n2'),
      !Parent('n5','n2'),
      !Parent('n6','n3'),
      !Parent('n7','n3'),
      !Parent('n2','n1'),
      !Parent('n3','n1'),

      !MemberLeaf('m1','n4'),
      !MemberLeaf('m2','n5'),
      !MemberLeaf('m3','n6'),
      !MemberLeaf('m4','n7'),

      !M1Base(~k4,~k2v0,~root0),
      !M2Base(~k5,~k2v0,~root0),
      !M3Base(~k6,~k3v0,~root0),
      !M4Base(~k7,~k3v0,~root0),

      !OwnsKey('m1','n4','v0',~k4),
      !OwnsKey('m1','n2','v0',~k2v0),
      !OwnsKey('m1','n1','v0',~root0),

      !OwnsKey('m2','n5','v0',~k5),
      !OwnsKey('m2','n2','v0',~k2v0),
      !OwnsKey('m2','n1','v0',~root0),

      !OwnsKey('m3','n6','v0',~k6),
      !OwnsKey('m3','n3','v0',~k3v0),
      !OwnsKey('m3','n1','v0',~root0),

      !OwnsKey('m4','n7','v0',~k7),
      !OwnsKey('m4','n3','v0',~k3v0),
      !OwnsKey('m4','n1','v0',~root0),

      !EpochRootKey(
          'e0',
          'v0',
          ~root0
      ),

      Stage('s0')
  ]


/********************************************************************
 * EPOCH 1
 *
 * Implemented plan:
 *
 *   revoke m4
 *
 *   target n3/v1 wrapper n6/v0 recipients {m3}
 *   target n1/v1 wrapper n2/v0 recipients {m1,m2}
 *   target n1/v1 wrapper n3/v1 recipients {m3}
 ********************************************************************/

rule Start_Epoch1:
  [
      Stage('s0'),

      !M1Base(k4,k2v0,root0),
      !M3Base(k6,k3v0,root0),

      Fr(~k3v1),
      Fr(~root1)
  ]
  --[
      RekeyStarted('e1'),

      NextEpoch('e0','e1'),

      AuthorizedAt('m1','e1'),
      AuthorizedAt('m2','e1'),
      AuthorizedAt('m3','e1'),

      RevokedAt('m4','e1'),

      KeyVersion(
          'n3',
          'v1',
          'e1'
      ),

      KeyVersion(
          'n1',
          'v1',
          'e1'
      ),

      EpochRoot(
          'e1',
          'v1',
          ~root1
      ),

      SecretEpoch(
          'e1',
          'v1',
          ~root1
      ),

      LkhUpdate(
          'e1',
          'n3',
          'v1',
          'n6',
          'v0'
      ),

      LkhRecipient(
          'e1',
          'n3',
          'v1',
          'm3'
      ),

      LkhUpdate(
          'e1',
          'n1',
          'v1',
          'n2',
          'v0'
      ),

      LkhRecipient(
          'e1',
          'n1',
          'v1',
          'm1'
      ),

      LkhRecipient(
          'e1',
          'n1',
          'v1',
          'm2'
      ),

      LkhUpdate(
          'e1',
          'n1',
          'v1',
          'n3',
          'v1'
      ),

      LkhRecipient(
          'e1',
          'n1',
          'v1',
          'm3'
      )
    ]->
  [
      !AuthorizedEpoch('m1','e1'),
      !AuthorizedEpoch('m2','e1'),
      !AuthorizedEpoch('m3','e1'),

      !RevokedEpoch('m4','e1'),

      !KeyMaterial(
          'n3',
          'v1',
          'e1',
          ~k3v1
      ),

      !EpochRootKey(
          'e1',
          'v1',
          ~root1
      ),

      !EpochCipher(
          'e1',
          'n3',
          'v1',
          'n6',
          'v0',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n3',
                  'v1',
                  ~k3v1
              >,
              k6
          )
      ),

      !EpochCipher(
          'e1',
          'n1',
          'v1',
          'n2',
          'v0',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  ~root1
              >,
              k2v0
          )
      ),

      !EpochCipher(
          'e1',
          'n1',
          'v1',
          'n3',
          'v1',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  ~root1
              >,
              ~k3v1
          )
      ),

      !ManagerEpoch1(
          ~k3v1,
          ~root1
      ),

      Stage('s1'),

      Out(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n3',
                  'v1',
                  ~k3v1
              >,
              k6
          )
      ),

      Out(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  ~root1
              >,
              k2v0
          )
      ),

      Out(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  ~root1
              >,
              ~k3v1
          )
      )
  ]


/********************************************************************
 * MEMBER 3 DERIVES THE UPDATED n3 KEY
 ********************************************************************/

rule M3_Derive_N3_V1:
  [
      !M3Base(k6,k3v0,root0),

      !KeyMaterial(
          'n3',
          'v1',
          'e1',
          k3v1
      ),

      In(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n3',
                  'v1',
                  k3v1
              >,
              k6
          )
      )
  ]
  --[
      DerivedKey(
          'm3',
          'n3',
          'v1',
          'e1'
      )
    ]->
  [
      !M3BranchE1(k3v1),

      !OwnsKey(
          'm3',
          'n3',
          'v1',
          k3v1
      )
  ]


/********************************************************************
 * INITIAL ACCEPTANCE — EPOCH 1
 ********************************************************************/

rule Accept_E1_M1:
  [
      !AuthorizedEpoch('m1','e1'),
      !M1Base(k4,k2v0,root0),
      !EpochRootKey('e1','v1',root1),

      In(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm1',
          'e1',
          'v1',
          root1
      ),

      AcceptCipher(
          'm1',
          'e1',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm1',
          'e1',
          'v1',
          root1
      ),

      !OwnsKey(
          'm1',
          'n1',
          'v1',
          root1
      )
  ]


rule Accept_E1_M2:
  [
      !AuthorizedEpoch('m2','e1'),
      !M2Base(k5,k2v0,root0),
      !EpochRootKey('e1','v1',root1),

      In(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm2',
          'e1',
          'v1',
          root1
      ),

      AcceptCipher(
          'm2',
          'e1',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm2',
          'e1',
          'v1',
          root1
      ),

      !OwnsKey(
          'm2',
          'n1',
          'v1',
          root1
      )
  ]


rule Accept_E1_M3:
  [
      !AuthorizedEpoch('m3','e1'),
      !M3BranchE1(k3v1),
      !EpochRootKey('e1','v1',root1),

      In(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k3v1
          )
      )
  ]
  --[
      Accept(
          'm3',
          'e1',
          'v1',
          root1
      ),

      AcceptCipher(
          'm3',
          'e1',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k3v1
          )
      )
    ]->
  [
      !Accepted(
          'm3',
          'e1',
          'v1',
          root1
      ),

      !OwnsKey(
          'm3',
          'n1',
          'v1',
          root1
      )
  ]


/********************************************************************
 * SAME-EPOCH RECOVERY — EPOCH 1
 ********************************************************************/

rule Recovery_Request_E1_M2:
  [
      !AuthorizedEpoch('m2','e1'),

      !EpochCipher(
          'e1',
          'n1',
          'v1',
          'n2',
          'v0',
          cipher
      )
  ]
  --[
      RecoveryRequest(
          'm2',
          'e1'
      )
    ]->
  [
      Recovering(
          'm2',
          'e1'
      ),

      Out(
          <
              'recovery-request',
              'm2',
              'e1'
          >
      )
  ]


rule Recovery_Response_E1_M1:
  [
      !AuthorizedEpoch('m1','e1'),

      !Accepted(
          'm1',
          'e1',
          'v1',
          root1
      ),

      !EpochCipher(
          'e1',
          'n1',
          'v1',
          'n2',
          'v0',
          cipher
      ),

      In(
          <
              'recovery-request',
              'm2',
              'e1'
          >
      )
  ]
  --[
      RecoveryResponse(
          'm1',
          'm2',
          'e1'
      )
    ]->
  [
      !RecoveryResponseCipher(
          'e1',
          cipher
      ),

      Out(cipher)
  ]


rule Recovery_Accept_E1_M2:
  [
      Recovering(
          'm2',
          'e1'
      ),

      !AuthorizedEpoch('m2','e1'),

      !M2Base(k5,k2v0,root0),

      !EpochRootKey(
          'e1',
          'v1',
          root1
      ),

      In(
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm2',
          'e1',
          'v1',
          root1
      ),

      RecoveryAccept(
          'm2',
          'e1'
      ),

      RecoveryAcceptCipher(
          'm2',
          'e1',
          senc(
              <
                  'lkh-update',
                  'e1',
                  'n1',
                  'v1',
                  root1
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm2',
          'e1',
          'v1',
          root1
      ),

      !OwnsKey(
          'm2',
          'n1',
          'v1',
          root1
      )
  ]


/********************************************************************
 * EPOCH 2
 *
 * Implemented plan:
 *
 *   revoke m3
 *
 *   target n1/v2 wrapper n2/v0 recipients {m1,m2}
 ********************************************************************/

rule Start_Epoch2:
  [
      Stage('s1'),

      !M1Base(k4,k2v0,root0),

      Fr(~root2)
  ]
  --[
      RekeyStarted('e2'),

      NextEpoch('e1','e2'),

      AuthorizedAt('m1','e2'),
      AuthorizedAt('m2','e2'),

      RevokedAt('m3','e2'),

      KeyVersion(
          'n1',
          'v2',
          'e2'
      ),

      EpochRoot(
          'e2',
          'v2',
          ~root2
      ),

      SecretEpoch(
          'e2',
          'v2',
          ~root2
      ),

      LkhUpdate(
          'e2',
          'n1',
          'v2',
          'n2',
          'v0'
      ),

      LkhRecipient(
          'e2',
          'n1',
          'v2',
          'm1'
      ),

      LkhRecipient(
          'e2',
          'n1',
          'v2',
          'm2'
      )
    ]->
  [
      !AuthorizedEpoch('m1','e2'),
      !AuthorizedEpoch('m2','e2'),

      !RevokedEpoch('m3','e2'),

      !EpochRootKey(
          'e2',
          'v2',
          ~root2
      ),

      !EpochCipher(
          'e2',
          'n1',
          'v2',
          'n2',
          'v0',
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  ~root2
              >,
              k2v0
          )
      ),

      !ManagerEpoch2(~root2),

      Stage('s2'),

      Out(
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  ~root2
              >,
              k2v0
          )
      )
  ]


/********************************************************************
 * INITIAL ACCEPTANCE — EPOCH 2
 ********************************************************************/

rule Accept_E2_M1:
  [
      !AuthorizedEpoch('m1','e2'),
      !M1Base(k4,k2v0,root0),
      !EpochRootKey('e2','v2',root2),

      In(
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm1',
          'e2',
          'v2',
          root2
      ),

      AcceptCipher(
          'm1',
          'e2',
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm1',
          'e2',
          'v2',
          root2
      ),

      !OwnsKey(
          'm1',
          'n1',
          'v2',
          root2
      )
  ]


rule Accept_E2_M2:
  [
      !AuthorizedEpoch('m2','e2'),
      !M2Base(k5,k2v0,root0),
      !EpochRootKey('e2','v2',root2),

      In(
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm2',
          'e2',
          'v2',
          root2
      ),

      AcceptCipher(
          'm2',
          'e2',
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm2',
          'e2',
          'v2',
          root2
      ),

      !OwnsKey(
          'm2',
          'n1',
          'v2',
          root2
      )
  ]


/********************************************************************
 * SAME-EPOCH RECOVERY — EPOCH 2
 ********************************************************************/

rule Recovery_Request_E2_M2:
  [
      !AuthorizedEpoch('m2','e2'),

      !EpochCipher(
          'e2',
          'n1',
          'v2',
          'n2',
          'v0',
          cipher
      )
  ]
  --[
      RecoveryRequest(
          'm2',
          'e2'
      )
    ]->
  [
      Recovering(
          'm2',
          'e2'
      ),

      Out(
          <
              'recovery-request',
              'm2',
              'e2'
          >
      )
  ]


rule Recovery_Response_E2_M1:
  [
      !AuthorizedEpoch('m1','e2'),

      !Accepted(
          'm1',
          'e2',
          'v2',
          root2
      ),

      !EpochCipher(
          'e2',
          'n1',
          'v2',
          'n2',
          'v0',
          cipher
      ),

      In(
          <
              'recovery-request',
              'm2',
              'e2'
          >
      )
  ]
  --[
      RecoveryResponse(
          'm1',
          'm2',
          'e2'
      )
    ]->
  [
      !RecoveryResponseCipher(
          'e2',
          cipher
      ),

      Out(cipher)
  ]


rule Recovery_Accept_E2_M2:
  [
      Recovering(
          'm2',
          'e2'
      ),

      !AuthorizedEpoch('m2','e2'),

      !M2Base(k5,k2v0,root0),

      !EpochRootKey(
          'e2',
          'v2',
          root2
      ),

      In(
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
  ]
  --[
      Accept(
          'm2',
          'e2',
          'v2',
          root2
      ),

      RecoveryAccept(
          'm2',
          'e2'
      ),

      RecoveryAcceptCipher(
          'm2',
          'e2',
          senc(
              <
                  'lkh-update',
                  'e2',
                  'n1',
                  'v2',
                  root2
              >,
              k2v0
          )
      )
    ]->
  [
      !Accepted(
          'm2',
          'e2',
          'v2',
          root2
      ),

      !OwnsKey(
          'm2',
          'n1',
          'v2',
          root2
      )
  ]


/********************************************************************
 * REPLAY OF OLD MATERIAL
 ********************************************************************/

rule Replay_E1_Root_Cipher_At_E2:
  [
      !EpochRootKey(
          'e2',
          'v2',
          root2
      ),

      !EpochCipher(
          'e1',
          'n1',
          'v1',
          'n2',
          'v0',
          oldcipher
      )
  ]
  --[
      ReplayOldCipher(
          'e1',
          'e2',
          oldcipher
      )
    ]->
  [
      Out(oldcipher)
  ]


rule Replay_E1_Recovery_Response_At_E2:
  [
      !EpochRootKey(
          'e2',
          'v2',
          root2
      ),

      !RecoveryResponseCipher(
          'e1',
          oldcipher
      )
  ]
  --[
      ReplayOldRecoveryResponse(
          'e1',
          'e2',
          oldcipher
      )
    ]->
  [
      Out(oldcipher)
  ]


/********************************************************************
 * EXPLICIT COMPROMISE
 ********************************************************************/

rule Compromise_M1:
  [
      !M1Base(k4,k2v0,root0)
  ]
  --[
      CompromiseMember('m1')
    ]->
  [
      Out(k4),
      Out(k2v0),
      Out(root0)
  ]


rule Compromise_M2:
  [
      !M2Base(k5,k2v0,root0)
  ]
  --[
      CompromiseMember('m2')
    ]->
  [
      Out(k5),
      Out(k2v0),
      Out(root0)
  ]


rule Compromise_M3:
  [
      !M3Base(k6,k3v0,root0)
  ]
  --[
      CompromiseMember('m3')
    ]->
  [
      Out(k6),
      Out(k3v0),
      Out(root0)
  ]


rule Compromise_M4:
  [
      !M4Base(k7,k3v0,root0)
  ]
  --[
      CompromiseMember('m4')
    ]->
  [
      Out(k7),
      Out(k3v0),
      Out(root0)
  ]


rule Compromise_GM_E1:
  [
      !ManagerEpoch1(
          k3v1,
          root1
      )
  ]
  --[
      CompromiseManager('e1')
    ]->
  [
      Out(k3v1),
      Out(root1)
  ]


rule Compromise_GM_E2:
  [
      !ManagerEpoch2(root2)
  ]
  --[
      CompromiseManager('e2')
    ]->
  [
      Out(root2)
  ]


/********************************************************************
 * REVOKED OLD-KEY EXPOSURE
 *
 * These are deliberately NOT classified as compromise exceptions
 * for the new epoch.
 ********************************************************************/

rule Leak_M4_Old_Keys_After_E1:
  [
      !RevokedEpoch('m4','e1'),

      !M4Base(
          k7,
          k3v0,
          root0
      )
  ]
  --[
      OldKeyLeak(
          'm4',
          'e1'
      )
    ]->
  [
      Out(k7),
      Out(k3v0),
      Out(root0)
  ]


rule Leak_M3_Old_Keys_After_E2:
  [
      !RevokedEpoch('m3','e2'),

      !M3Base(
          k6,
          k3v0,
          root0
      ),

      !M3BranchE1(k3v1),

      !Accepted(
          'm3',
          'e1',
          'v1',
          root1
      )
  ]
  --[
      OldKeyLeak(
          'm3',
          'e2'
      )
    ]->
  [
      Out(k6),
      Out(k3v0),
      Out(root0),
      Out(k3v1),
      Out(root1)
  ]


/********************************************************************
 * NON-VACUITY
 ********************************************************************/

lemma executable_first_lkh_rekey:
  exists-trace
  "
    Ex root #i.
      RekeyStarted('e1') @ i
    & EpochRoot('e1','v1',root) @ i
  "


lemma executable_second_lkh_rekey:
  exists-trace
  "
    Ex root1 root2 #i #j.
      EpochRoot('e1','v1',root1) @ i
    & EpochRoot('e2','v2',root2) @ j
    & i < j
  "


lemma executable_same_epoch_recovery_after_lkh_rekey:
  exists-trace
  "
    Ex #q #r #a.
      RecoveryRequest('m2','e1') @ q
    & RecoveryResponse('m1','m2','e1') @ r
    & RecoveryAccept('m2','e1') @ a
    & q < r
    & r < a
  "


lemma executable_old_cipher_replay:
  exists-trace
  "
    Ex c #i #r.
      RekeyStarted('e2') @ i
    & ReplayOldCipher('e1','e2',c) @ r
    & i < r
  "


/********************************************************************
 * MULTI-EPOCH ORDERING
 ********************************************************************/

lemma second_epoch_follows_first:
  "
    All #j.
      RekeyStarted('e2') @ j
      ==>
      (Ex #i.
         RekeyStarted('e1') @ i
       & NextEpoch('e1','e2') @ j
       & i < j)
  "


/********************************************************************
 * REVOCATION
 ********************************************************************/

lemma revoked_member_excluded_from_new_epoch:
  "
    All m e v root #r #a.
      RevokedAt(m,e) @ r
    & Accept(m,e,v,root) @ a
      ==> F
  "


/********************************************************************
 * LKH UPDATE ORIGIN
 ********************************************************************/

lemma survivor_acceptance_has_lkh_update_chain:
  "
    All m e v root #a.
      Accept(m,e,v,root) @ a
      ==>
      (Ex wrapper wrapperVersion #u.
         LkhUpdate(
             e,
             'n1',
             v,
             wrapper,
             wrapperVersion
         ) @ u
       & LkhRecipient(
             e,
             'n1',
             v,
             m
         ) @ u
       & u < a)
  "


lemma m3_acceptance_requires_branch_update:
  "
    All root #a.
      Accept('m3','e1','v1',root) @ a
      ==>
      (Ex #d.
         DerivedKey(
             'm3',
             'n3',
             'v1',
             'e1'
         ) @ d
       & d < a)
  "


lemma acceptance_matches_current_root_version:
  "
    All m e v root #a.
      Accept(m,e,v,root) @ a
      ==>
      (Ex #r.
         EpochRoot(e,v,root) @ r
       & r < a)
  "


/********************************************************************
 * REPLAY / FRESHNESS
 ********************************************************************/

lemma replay_old_capsule_cannot_accept_new_epoch:
  "
    All m c #r #a.
      ReplayOldCipher('e1','e2',c) @ r
    & AcceptCipher(m,'e2',c) @ a
      ==> F
  "


lemma replay_old_recovery_response_cannot_accept_new_epoch:
  "
    All m c #r #a.
      ReplayOldRecoveryResponse(
          'e1',
          'e2',
          c
      ) @ r
    & RecoveryAcceptCipher(
          m,
          'e2',
          c
      ) @ a
      ==> F
  "


lemma root_keys_fresh_across_epochs:
  "
    All root1 root2 #i #j.
      EpochRoot(
          'e1',
          'v1',
          root1
      ) @ i
    & EpochRoot(
          'e2',
          'v2',
          root2
      ) @ j
      ==>
      not (root1 = root2)
  "


/********************************************************************
 * SECRECY + COMPROMISE TIMING
 *
 * A compromise only explains adversarial root-key knowledge if:
 *
 *   - the compromised member was authorized in that epoch, or
 *   - that epoch's manager state was compromised,
 *
 * and the compromise occurred BEFORE K(root).
 ********************************************************************/

lemma new_epoch_key_secret_without_relevant_compromise:
  "
    All e v root #s #k.
      SecretEpoch(e,v,root) @ s
    & K(root) @ k
      ==>
      (
        (Ex m #a #c.
           AuthorizedAt(m,e) @ a
         & CompromiseMember(m) @ c
         & c < k)
        |
        (Ex #c.
           CompromiseManager(e) @ c
         & c < k)
      )
  "


lemma revoked_old_key_does_not_reveal_new_root_key:
  "
    All m e v root #l #s #k.
      OldKeyLeak(m,e) @ l
    & SecretEpoch(e,v,root) @ s
    & K(root) @ k
      ==>
      (
        (Ex survivor #a #c.
           AuthorizedAt(survivor,e) @ a
         & CompromiseMember(survivor) @ c
         & c < k)
        |
        (Ex #c.
           CompromiseManager(e) @ c
         & c < k)
      )
  "


/********************************************************************
 * RECOVERY AUTHORIZATION
 ********************************************************************/

lemma recovery_requester_authorized_in_same_epoch:
  "
    All requester e #r.
      RecoveryRequest(requester,e) @ r
      ==>
      (Ex #a.
         AuthorizedAt(requester,e) @ a
       & a < r)
  "


lemma recovery_helper_authorized_in_same_epoch:
  "
    All helper requester e #r.
      RecoveryResponse(
          helper,
          requester,
          e
      ) @ r
      ==>
      (Ex #a.
         AuthorizedAt(helper,e) @ a
       & a < r)
  "


end
