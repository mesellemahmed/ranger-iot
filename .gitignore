# ---------------------------------------------------------------------------
# Scientific experiment artifacts
# ---------------------------------------------------------------------------
# Publication results are intentionally versioned.
# DO NOT ignore:
#   experiments/results/
#   experiments/cooja/results/
#
# Temporary or scratch experiment outputs only:
experiments/**/tmp/
experiments/**/scratch/

# Contiki-NG / Cooja transient build artifacts
**/.gradle/
experiments/cooja/**/build/
experiments/cooja/**/*.elf
experiments/cooja/**/*.hex
experiments/cooja/**/*.bin
experiments/cooja/**/*.o
experiments/cooja/**/*.d

# Cooja scientific logs are publication artifacts and must be versioned
!experiments/cooja/results/**/*.log

# Local development patches/installers
step*.patch
step*.zip
step*.py

# ------------------------------------------------------------------
# Scientific results MUST be versioned for reproducibility
# ------------------------------------------------------------------
!experiments/results/
!experiments/results/**
!experiments/cooja/
!experiments/cooja/results/
!experiments/cooja/results/**
!experiments/evidence/
!experiments/evidence/**

