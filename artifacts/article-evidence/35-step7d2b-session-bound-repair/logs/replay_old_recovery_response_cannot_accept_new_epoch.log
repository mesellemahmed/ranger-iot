lemma second_epoch_follows_first:
  all-traces
  "∀ sid #j.
    (RekeyStarted( sid, 'e2' ) @ #j) ⇒
    (∃ #i.
      ((RekeyStarted( sid, 'e1' ) @ #i) ∧
       (NextEpoch( sid, 'e1', 'e2' ) @ #j)) ∧
      (#i < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ sid #j.
  (RekeyStarted( sid, 'e2' ) @ #j)
 ∧
  ∀ #i.
   (RekeyStarted( sid, 'e1' ) @ #i) ∧ (NextEpoch( sid, 'e1', 'e2' ) @ #j)
  ⇒
   ¬(#i < #j)"
*/
by sorry

