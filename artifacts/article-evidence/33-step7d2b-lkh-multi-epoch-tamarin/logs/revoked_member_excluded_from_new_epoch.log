lemma revoked_member_excluded_from_new_epoch:
  all-traces
  "∀ m e v root #r #a.
    ((RevokedAt( m, e ) @ #r) ∧ (Accept( m, e, v, root ) @ #a)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ m e v root #r #a.
  (RevokedAt( m, e ) @ #r) ∧ (Accept( m, e, v, root ) @ #a)"
*/
simplify
solve( RevokedAt( m, e ) @ #r )
  case Start_Epoch1
  solve( Stage( 's0' ) ▶₀ #r )
    case Setup
    solve( !M1Base( k4, k2v0, root0 ) ▶₁ #r )
      case Setup
      solve( !M3Base( k6, k3v0, ~root0 ) ▶₂ #r )
        case Setup
        by solve( Accept( 'm4', 'e1', v, root ) @ #a )
      qed
    qed
  qed
next
  case Start_Epoch2
  solve( Stage( 's1' ) ▶₀ #r )
    case Start_Epoch1
    solve( !M1Base( k4, k2v0, root0 ) ▶₁ #r )
      case Setup
      by solve( Accept( 'm3', 'e2', v, root ) @ #a )
    qed
  qed
qed

