 ∧
  (#i < #j) ∧ (#j < #k)"
*/
simplify
solve( Stale( $A, e, gk ) ▶₀ #i )
  case Start_Rekey_case_1
  solve( !AuthorizedEpoch( $A, ~epoch ) ▶₁ #i )
    case Start_Rekey_case_1
    solve( Current( $H, ~epoch, gk ) ▶₀ #j )
      case Accept_Initial_case_2
      solve( !AuthorizedEpoch( $H, ~epoch ) ▶₁ #j )
        case Start_Rekey_case_2
        solve( !AuthorizedEpoch( $A, ~epoch ) ▶₂ #j )
          case Start_Rekey_case_1
          solve( !EpochCipher( ~epoch, ~groupkey, ciphertext ) ▶₃ #j )
            case Start_Rekey
            solve( Recovering( $A, ~epoch, gk ) ▶₀ #k )
              case Start_Recovery
              solve( !AuthorizedEpoch( $A, ~epoch ) ▶₁ #k )
                case Start_Rekey_case_1
                solve( !MemberKey( $A, k.1 ) ▶₂ #k )
                  case Setup_case_1
                  solve( !KU( senc(<'ranger-capsule', ~epoch, ~groupkey>, ~ksurvivor.1)
                         ) @ #vk.5 )
                    case Start_Rekey
                    solve( !KU( ~epoch ) @ #vk.5 )
                      case Start_Recovery
                      solve( !KU( senc(<'ranger-capsule', ~epoch, ~groupkey>, ~ksurvivor.1)
                             ) @ #vk.6 )
                        case Start_Rekey
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

