+ docker compose -f compose.reproducibility.yaml run --rm -T --no-deps tamarin bash -lc '
      set -euo pipefail

      echo "===== ENVIRONMENT ====="

      echo "architecture=$(uname -m)"

      echo "brew=$(command -v brew)"
      echo "tamarin=$(command -v tamarin-prover)"
      echo "maude=$(command -v maude)"
      echo "dot=$(command -v dot)"

      echo
      echo "===== VERSIONS ====="

      brew --version

      tamarin-prover --version

      maude --version 2>&1 \
        | head -n 5 \
        || true

      dot -V 2>&1

      echo
      echo "===== PINNED HOMEBREW CORE ====="

      CORE="$(brew --repository homebrew/core)"

      echo "core_repository=$CORE"

      git \
        -C "$CORE" \
        rev-parse HEAD

      echo
      echo "===== INSTALLED FORMULAE ====="

      brew list --versions \
        tamarin-prover \
        maude \
        libbuddy \
        graphviz

      echo
      echo "===== TAMARIN SELFTEST ====="

      tamarin-prover test

      echo
      echo "OFFLINE_TAMARIN_RUNTIME_CONTRACT=PASS"
    '
